# Salin file ini menjadi .env, lalu isi ADMIN_PASS.
#
#   cp .env.example .env
#
# .env sudah masuk .gitignore. JANGAN di-commit.
#
# Aturan main:
#   - Variable yang sudah ada di environment (shell, `FOO=1 npm start`) tetap
#     menang atas isi file ini.
#   - Nilai kosong (STATE_DIR=) berarti "pakai default".
#   - Baris tanpa "=" diabaikan diam-diam. Kalau ADMIN_PASS salah ketik,
#     gejalanya exit 2 "Password AP belum diisi".

# --- AP -------------------------------------------------------------------
AP_HOST=192.168.10.1
ADMIN_USER=CMCCAdmin
ADMIN_PASS=
HTTP_TIMEOUT_MS=15000

# --- Lokasi file ----------------------------------------------------------
# Default: ~/.local/state/wifictl (lock, schedule-state.json, log)
STATE_DIR=
LOG_FILE=
LOG_MAX_BYTES=1048576
LOG_MAX_FILES=2

# Sumber kebenaran untuk `sync`. Default: ./blacklist.txt
BLACKLIST_FILE=

# --- Rule blacklist per jam (rules.json) ---------------------------------
# Rule di rules.json hanya berlaku di dalam jamnya; di luar jam itu MAC-nya
# dilepas lagi.
RULES_FILE=
# Kosong = jam lokal mesin. Laptop ini Asia/Jakarta, jadi biasanya biarkan.
# Isi kalau repo ini nanti jalan di mesin dengan zona lain, mis. Asia/Makassar
# atau UTC.
RULES_TZ=
RULES_ENABLED=true

# --- Jadwal schedule:run --------------------------------------------------
# 5 field cron. Cron memanggil `schedule:run` tiap menit; dia yang memutuskan
# task mana yang sudah jatuh tempo.
SYNC_CRON=*/30 * * * *
RULES_CRON=* * * * *
AUDIT_CRON=5 * * * *
SYNC_ENABLED=true
AUDIT_ENABLED=true

# Panjang minimum satu sync; sync yang lebih lama dari ini lock-nya bisa dicuri.
LOCK_STALE_MS=120000

# --- Dashboard (serve) ----------------------------------------------------
HOST=127.0.0.1
PORT=8080

# Wajib diisi kalau HOST bukan loopback — endpoint ini bisa memblokir
# perangkat dari jaringan. Kalau kosong, server menolak start.
API_TOKEN=